{
	"primitive": {
		"color-gray-0": "#ffffff",
		"color-gray-100": "#f1f5f9",
		"color-gray-900": "#0f172a",
		"color-blue-600": "#2563eb",
		"color-blue-400": "#60a5fa",
		"color-green-700": "#15803d",
		"color-green-400": "#4ade80",
		"space-1": "0.25rem",
		"space-2": "0.5rem",
		"space-3": "0.75rem",
		"space-4": "1rem",
		"space-6": "1.5rem",
		"font-size-sm": "0.875rem",
		"font-size-md": "1rem"
	},
	"themes": {
		"light": {
			"color-bg": "var(--color-gray-0)",
			"color-fg": "var(--color-gray-900)",
			"color-muted": "var(--color-gray-100)",
			"color-border": "#64748b",
			"color-danger": "#b91c1c"
		},
		"dark": {
			"color-bg": "var(--color-gray-900)",
			"color-fg": "var(--color-gray-0)",
			"color-muted": "#1e293b",
			"color-border": "#94a3b8",
			"color-danger": "#fca5a5"
		}
	},
	"brands": {
		"acme": {
			"base": { "radius-md": "0.5rem" },
			"light": {
				"color-primary": "var(--color-blue-600)",
				"color-primary-fg": "#ffffff"
			},
			"dark": {
				"color-primary": "var(--color-blue-400)",
				"color-primary-fg": "#0f172a"
			}
		},
		"globex": {
			"base": { "radius-md": "0.125rem" },
			"light": {
				"color-primary": "var(--color-green-700)",
				"color-primary-fg": "#ffffff"
			},
			"dark": {
				"color-primary": "var(--color-green-400)",
				"color-primary-fg": "#0f172a"
			}
		}
	}
}
